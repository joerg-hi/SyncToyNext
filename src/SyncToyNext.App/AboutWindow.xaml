<Window x:Class="SyncToyNext.App.AboutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Über SyncToyNext"
        Icon="Assets/SyncToyNext.ico"
        Width="520" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <StackPanel>
        <StackPanel Margin="28,24,28,8">
            <StackPanel Orientation="Horizontal">
                <Image Source="{StaticResource LogoImage}" Width="72" Height="72" />
                <StackPanel Margin="18,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="SyncToyNext" FontSize="26" FontWeight="SemiBold" />
                    <TextBlock x:Name="VersionText" Style="{StaticResource SecondaryText}" />
                </StackPanel>
            </StackPanel>

            <TextBlock Style="{StaticResource SecondaryText}" Margin="0,18,0,0"
                       Text="Ein freier Nachbau von Microsoft SyncToy 2.1: Synchronize, Echo und Contribute mit Vorschau, Filtern, Erkennung von Umbenennungen und Papierkorb." />
            <TextBlock Style="{StaticResource CaptionText}" Margin="0,8,0,0"
                       Text="Unabhängiges Projekt ohne Verbindung zu Microsoft. „SyncToy“ ist eine Marke von Microsoft." />

            <Border Style="{StaticResource Card}" Margin="0,16,0,0" Padding="14,10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Text="Ordnerpaare" FontWeight="SemiBold" Margin="0,3,14,3" />
                    <TextBlock Grid.Row="0" Grid.Column="1" x:Name="PairsPathText" TextWrapping="Wrap" Margin="0,3" />
                    <TextBlock Grid.Row="1" Text="Protokoll" FontWeight="SemiBold" Margin="0,3,14,3" />
                    <TextBlock Grid.Row="1" Grid.Column="1" x:Name="LogPathText" TextWrapping="Wrap" Margin="0,3" />
                    <TextBlock Grid.Row="2" Text="Lizenz" FontWeight="SemiBold" Margin="0,3,14,3" />
                    <TextBlock Grid.Row="2" Grid.Column="1" Text="MIT" Margin="0,3" />
                </Grid>
            </Border>
        </StackPanel>

        <Border BorderThickness="0,1,0,0" BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}"
                Background="{DynamicResource LayerFillColorDefaultBrush}" Padding="28,14" Margin="0,16,0,0">
            <DockPanel>
                <Button DockPanel.Dock="Right" Content="Schließen" IsCancel="True" IsDefault="True" MinWidth="110" />
                <Button Style="{StaticResource LinkButton}" Click="Website_Click" HorizontalAlignment="Left">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource Glyph}" Text="&#xE774;" FontSize="14" />
                        <TextBlock Text="Projektseite auf GitHub" Margin="8,0,0,0" />
                    </StackPanel>
                </Button>
            </DockPanel>
        </Border>
    </StackPanel>
</Window>
