<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <AssemblyName>SyncToyNext</AssemblyName>
    <RootNamespace>SyncToyNext.App</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\SyncToyNext.ico</ApplicationIcon>
  </PropertyGroup>
  <ItemGroup>
    <Resource Include="Assets\SyncToyNext.ico" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\SyncToyNext.Core\SyncToyNext.Core.csproj" />
  </ItemGroup>
</Project>
