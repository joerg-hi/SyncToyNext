<Window x:Class="SyncToyNext.App.FolderPairWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Ordnerpaar"
        Icon="Assets/SyncToyNext.ico"
        Width="700" Height="760" MinWidth="560" MinHeight="480"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="24,16,24,16">
                <TextBlock x:Name="HeaderText" FontSize="22" FontWeight="SemiBold" />

                <!-- Name und Ordner -->
                <Border Style="{StaticResource Card}" Margin="0,16,0,0">
                    <StackPanel>
                        <TextBlock Text="Name" FontWeight="SemiBold" Margin="0,0,0,6" />
                        <TextBox x:Name="NameBox" />

                        <TextBlock Text="Linker Ordner" Style="{StaticResource FieldLabel}" />
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Margin="8,0,0,0" Click="BrowseLeft_Click" ToolTip="Ordner auswählen">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Style="{StaticResource Glyph}" Text="&#xE838;" />
                                    <TextBlock Text="Durchsuchen" Margin="8,0,0,0" />
                                </StackPanel>
                            </Button>
                            <TextBox x:Name="LeftBox" AllowDrop="True"
                                     PreviewDragOver="PathBox_PreviewDragOver" PreviewDrop="PathBox_PreviewDrop" />
                        </DockPanel>

                        <TextBlock Text="Rechter Ordner" Style="{StaticResource FieldLabel}" />
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Margin="8,0,0,0" Click="BrowseRight_Click" ToolTip="Ordner auswählen">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Style="{StaticResource Glyph}" Text="&#xE838;" />
                                    <TextBlock Text="Durchsuchen" Margin="8,0,0,0" />
                                </StackPanel>
                            </Button>
                            <TextBox x:Name="RightBox" AllowDrop="True"
                                     PreviewDragOver="PathBox_PreviewDragOver" PreviewDrop="PathBox_PreviewDrop" />
                        </DockPanel>
                        <TextBlock Style="{StaticResource CaptionText}" Margin="0,8,0,0"
                                   Text="Ordner lassen sich auch aus dem Explorer in die Felder ziehen." />
                    </StackPanel>
                </Border>

                <!-- Aktion -->
                <TextBlock Text="Was soll passieren?" Style="{StaticResource SectionTitle}" Margin="2,20,0,8" />
                <Border Style="{StaticResource Card}" Padding="12,8">
                    <StackPanel>
                        <RadioButton x:Name="SynchronizeRadio" GroupName="Action" Margin="0,6">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Style="{StaticResource Glyph}" Text="&#xE8AB;" FontSize="20" Width="28"
                                           VerticalAlignment="Top" Margin="0,2,0,0"
                                           Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                                <StackPanel Grid.Column="1" Margin="8,0,0,0">
                                    <TextBlock Text="Synchronize" FontWeight="SemiBold" />
                                    <TextBlock x:Name="SynchronizeText" Style="{StaticResource SecondaryText}" />
                                </StackPanel>
                            </Grid>
                        </RadioButton>
                        <RadioButton x:Name="EchoRadio" GroupName="Action" Margin="0,6">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Style="{StaticResource Glyph}" Text="&#xE72A;" FontSize="20" Width="28"
                                           VerticalAlignment="Top" Margin="0,2,0,0"
                                           Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                                <StackPanel Grid.Column="1" Margin="8,0,0,0">
                                    <TextBlock Text="Echo" FontWeight="SemiBold" />
                                    <TextBlock x:Name="EchoText" Style="{StaticResource SecondaryText}" />
                                </StackPanel>
                            </Grid>
                        </RadioButton>
                        <RadioButton x:Name="ContributeRadio" GroupName="Action" Margin="0,6">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Style="{StaticResource Glyph}" Text="&#xE8C8;" FontSize="20" Width="28"
                                           VerticalAlignment="Top" Margin="0,2,0,0"
                                           Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                                <StackPanel Grid.Column="1" Margin="8,0,0,0">
                                    <TextBlock Text="Contribute" FontWeight="SemiBold" />
                                    <TextBlock x:Name="ContributeText" Style="{StaticResource SecondaryText}" />
                                </StackPanel>
                            </Grid>
                        </RadioButton>
                    </StackPanel>
                </Border>

                <!-- Optionen -->
                <Expander x:Name="OptionsExpander" Margin="0,20,0,0">
                    <Expander.Header>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource Glyph}" Text="&#xE713;" />
                            <TextBlock Text="Optionen" FontWeight="SemiBold" Margin="10,0,0,0" />
                        </StackPanel>
                    </Expander.Header>
                    <StackPanel Margin="4,4,4,8">
                        <TextBlock Text="Einzuschließende Dateien" Style="{StaticResource FieldLabel}" />
                        <TextBox x:Name="IncludeBox" />
                        <TextBlock Style="{StaticResource CaptionText}" Margin="0,4,0,0"
                                   Text="Platzhalter * und ?, mehrere Muster mit ; oder , trennen. Beispiel: *.docx; *.xlsx" />

                        <TextBlock Text="Auszuschließende Dateien" Style="{StaticResource FieldLabel}" />
                        <TextBox x:Name="ExcludeBox" />
                        <TextBlock Style="{StaticResource CaptionText}" Margin="0,4,0,0" Text="Beispiel: *.tmp; ~$*; Thumbs.db" />

                        <TextBlock Text="Ausgeschlossene Unterordner" Style="{StaticResource FieldLabel}" />
                        <DockPanel>
                            <StackPanel DockPanel.Dock="Right" Margin="8,0,0,0">
                                <Button HorizontalAlignment="Stretch" Click="AddSubfolder_Click">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Style="{StaticResource Glyph}" Text="&#xE710;" />
                                        <TextBlock Text="Hinzufügen" Margin="8,0,0,0" />
                                    </StackPanel>
                                </Button>
                                <Button HorizontalAlignment="Stretch" Margin="0,6,0,0" Click="RemoveSubfolder_Click">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Style="{StaticResource Glyph}" Text="&#xE74D;" />
                                        <TextBlock Text="Entfernen" Margin="8,0,0,0" />
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                            <ListBox x:Name="SubfolderList" Height="90" SelectionMode="Extended"
                                     BorderThickness="1" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" />
                        </DockPanel>
                        <TextBlock Style="{StaticResource CaptionText}" Margin="0,4,0,0"
                                   Text="Pfade relativ zum linken bzw. rechten Ordner. Sie gelten auf beiden Seiten." />

                        <TextBlock Text="Dateien mit diesen Attributen ausschließen" Style="{StaticResource FieldLabel}" />
                        <WrapPanel>
                            <CheckBox x:Name="ExcludeReadOnlyBox" Content="Schreibgeschützt" Margin="0,0,20,0" />
                            <CheckBox x:Name="ExcludeHiddenBox" Content="Versteckt" Margin="0,0,20,0" />
                            <CheckBox x:Name="ExcludeSystemBox" Content="System" />
                        </WrapPanel>

                        <TextBlock Text="Weitere Optionen" Style="{StaticResource FieldLabel}" />
                        <CheckBox x:Name="RecycleBox" Content="Überschriebene und gelöschte Dateien in den Papierkorb verschieben" />
                        <CheckBox x:Name="CheckContentsBox" Margin="0,4,0,0"
                                  Content="Dateiinhalte prüfen (langsamer, erkennt aber gleiche Dateien mit anderem Datum)" />
                        <CheckBox x:Name="ActiveForRunAllBox" Margin="0,4,0,0" Content="Bei „Alle ausführen“ berücksichtigen" />
                    </StackPanel>
                </Expander>
            </StackPanel>
        </ScrollViewer>

        <!-- Fußzeile -->
        <Border Grid.Row="1" BorderThickness="0,1,0,0" BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}"
                Background="{DynamicResource LayerFillColorDefaultBrush}" Padding="24,14">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="OkButton" Style="{StaticResource PrimaryButton}" IsDefault="True" Click="Ok_Click" />
                    <Button Content="Abbrechen" IsCancel="True" MinWidth="110" Margin="8,0,0,0" />
                </StackPanel>
                <Border x:Name="ErrorBar" Style="{StaticResource InfoBarError}" Visibility="Collapsed" Margin="0,0,16,0"
                        VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource Glyph}" Text="&#xE783;" Foreground="{DynamicResource SystemFillColorCriticalBrush}" />
                        <TextBlock x:Name="ErrorText" TextWrapping="Wrap" Margin="8,0,0,0" MaxWidth="360" />
                    </StackPanel>
                </Border>
            </DockPanel>
        </Border>
    </Grid>
</Window>
