<Window x:Class="SyncToyNext.App.PreviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Vorschau"
        Width="1040" Height="620" MinWidth="700" MinHeight="400"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <DockPanel Margin="12">
        <TextBlock x:Name="HeaderText" DockPanel.Dock="Top" FontSize="17" FontWeight="SemiBold" TextWrapping="Wrap" />
        <TextBlock x:Name="SummaryText" DockPanel.Dock="Top" TextWrapping="Wrap" Margin="0,4,0,6" />

        <Expander x:Name="WarningsExpander" DockPanel.Dock="Top" Visibility="Collapsed" Margin="0,0,0,6" IsExpanded="True">
            <ListBox x:Name="WarningsList" MaxHeight="110" Margin="0,4,0,0" />
        </Expander>

        <DockPanel DockPanel.Dock="Bottom" Margin="0,8,0,0" LastChildFill="True">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button x:Name="RunButton" Content="Ausführen" FontWeight="SemiBold" Click="Run_Click" IsEnabled="False" />
                <Button x:Name="CancelButton" Content="Abbrechen" Click="Cancel_Click" Visibility="Collapsed" />
                <Button x:Name="CloseButton" Content="Schließen" Click="Close_Click" />
            </StackPanel>
            <StackPanel x:Name="SelectionButtons" DockPanel.Dock="Left" Orientation="Horizontal">
                <Button Content="Alle auswählen" Click="SelectAll_Click" />
                <Button Content="Keine auswählen" Click="SelectNone_Click" />
            </StackPanel>
            <StackPanel VerticalAlignment="Center" Margin="10,0">
                <ProgressBar x:Name="Progress" Height="14" Maximum="1" Visibility="Hidden" />
                <TextBlock x:Name="ProgressText" TextTrimming="CharacterEllipsis" Margin="0,2,0,0" />
            </StackPanel>
        </DockPanel>

        <DataGrid x:Name="OperationsGrid"
                  AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False"
                  HeadersVisibility="Column" SelectionMode="Extended" GridLinesVisibility="Horizontal"
                  HorizontalGridLinesBrush="{x:Static SystemColors.ControlLightBrush}"
                  EnableRowVirtualization="True" VirtualizingPanel.IsVirtualizingWhenGrouping="True">
            <DataGrid.Columns>
                <DataGridTemplateColumn Header="" Width="32" CanUserSort="False">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <CheckBox HorizontalAlignment="Center" VerticalAlignment="Center"
                                      IsChecked="{Binding Operation.IsSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                      IsEnabled="{Binding IsEditable}" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn x:Name="PairColumn" Header="Ordnerpaar" Binding="{Binding PairName}" IsReadOnly="True" Width="130" />
                <DataGridTextColumn Header="Aktion" Binding="{Binding Operation.KindText}" IsReadOnly="True" Width="110" />
                <DataGridTextColumn Header="Ziel" Binding="{Binding Operation.DirectionSymbol}" IsReadOnly="True" Width="50" />
                <DataGridTextColumn Header="Datei / Ordner" Binding="{Binding Operation.DisplayPath}" IsReadOnly="True" Width="*" />
                <DataGridTextColumn Header="Größe" Binding="{Binding SizeText}" IsReadOnly="True" Width="80" SortMemberPath="Operation.Size">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="HorizontalAlignment" Value="Right" />
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
                <DataGridTextColumn Header="Grund" Binding="{Binding Operation.Reason}" IsReadOnly="True" Width="190" />
                <DataGridTextColumn Header="Ergebnis" Binding="{Binding StatusText}" IsReadOnly="True" Width="190" />
            </DataGrid.Columns>
        </DataGrid>
    </DockPanel>
</Window>
