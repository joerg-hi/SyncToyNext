<Window x:Class="SyncToyNext.App.PreviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:planning="clr-namespace:SyncToyNext.Core.Planning;assembly=SyncToyNext.Core"
        Title="Vorschau"
        Icon="Assets/SyncToyNext.ico"
        Width="1120" Height="680" MinWidth="760" MinHeight="440"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <Window.Resources>
        <!-- Farbe des Aktionssymbols -->
        <Style x:Key="KindGlyphStyle" TargetType="TextBlock" BasedOn="{StaticResource Glyph}">
            <Setter Property="Foreground" Value="{DynamicResource AccentTextFillColorPrimaryBrush}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Operation.Kind}" Value="{x:Static planning:OperationKind.Delete}">
                    <Setter Property="Foreground" Value="{DynamicResource SystemFillColorCriticalBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Operation.Kind}" Value="{x:Static planning:OperationKind.DeleteFolder}">
                    <Setter Property="Foreground" Value="{DynamicResource SystemFillColorCriticalBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Operation.Kind}" Value="{x:Static planning:OperationKind.Overwrite}">
                    <Setter Property="Foreground" Value="{DynamicResource SystemFillColorCautionBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- Farbe des Ergebnissymbols -->
        <Style x:Key="StatusGlyphStyle" TargetType="TextBlock" BasedOn="{StaticResource Glyph}">
            <Setter Property="FontSize" Value="13" />
            <!-- ohne Ergebnis wird nur bei der laufenden Aktion ein Zeichen angezeigt -->
            <Setter Property="Foreground" Value="{DynamicResource AccentTextFillColorPrimaryBrush}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Operation.Status}" Value="{x:Static planning:OperationStatus.Succeeded}">
                    <Setter Property="Foreground" Value="{DynamicResource SystemFillColorSuccessBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Operation.Status}" Value="{x:Static planning:OperationStatus.Failed}">
                    <Setter Property="Foreground" Value="{DynamicResource SystemFillColorCriticalBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Operation.Status}" Value="{x:Static planning:OperationStatus.Skipped}">
                    <Setter Property="Foreground" Value="{DynamicResource SystemFillColorCautionBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Kopf -->
        <StackPanel Grid.Row="0" Margin="24,16,24,0">
            <StackPanel Orientation="Horizontal">
                <Border Style="{StaticResource IconBadge}" Width="40" Height="40" CornerRadius="20"
                        Background="{DynamicResource AccentFillColorDefaultBrush}">
                    <TextBlock x:Name="HeaderGlyph" Style="{StaticResource Glyph}" FontSize="18" Text="&#xE890;"
                               Foreground="{DynamicResource TextOnAccentFillColorPrimaryBrush}" />
                </Border>
                <StackPanel Margin="14,0,0,0" VerticalAlignment="Center">
                    <TextBlock x:Name="HeaderText" FontSize="20" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                    <TextBlock x:Name="SubHeaderText" Style="{StaticResource CaptionText}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
                </StackPanel>
            </StackPanel>

            <!-- Linker und rechter Ordner je Ordnerpaar -->
            <ItemsControl x:Name="PairFoldersList" Margin="0,12,0,0">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Grid Margin="0,0,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" VerticalAlignment="Center"
                                       Margin="0,0,12,0" Visibility="{Binding NameVisibility}" MaxWidth="180"
                                       TextTrimming="CharacterEllipsis" />
                            <Border Grid.Column="1" Style="{StaticResource Card}" Padding="10,6" ToolTip="{Binding Left}">
                                <DockPanel>
                                    <TextBlock DockPanel.Dock="Left" Style="{StaticResource Glyph}" Text="&#xE8B7;"
                                               Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                                    <TextBlock DockPanel.Dock="Left" Text="Links" Style="{StaticResource CaptionText}" FontWeight="SemiBold"
                                               VerticalAlignment="Center" Margin="8,0,8,0" />
                                    <TextBlock DockPanel.Dock="Left" Text="{Binding LeftName}" FontWeight="SemiBold"
                                               VerticalAlignment="Center" Margin="0,0,8,0" />
                                    <TextBlock Text="{Binding Left}" Style="{StaticResource CaptionText}" VerticalAlignment="Center"
                                               TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />
                                </DockPanel>
                            </Border>
                            <TextBlock Grid.Column="2" Style="{StaticResource Glyph}" Text="{Binding ArrowGlyph}"
                                       ToolTip="{Binding ActionTitle}" FontSize="18" Margin="12,0"
                                       Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                            <Border Grid.Column="3" Style="{StaticResource Card}" Padding="10,6" ToolTip="{Binding Right}">
                                <DockPanel>
                                    <TextBlock DockPanel.Dock="Left" Style="{StaticResource Glyph}" Text="&#xE8B7;"
                                               Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                                    <TextBlock DockPanel.Dock="Left" Text="Rechts" Style="{StaticResource CaptionText}" FontWeight="SemiBold"
                                               VerticalAlignment="Center" Margin="8,0,8,0" />
                                    <TextBlock DockPanel.Dock="Left" Text="{Binding RightName}" FontWeight="SemiBold"
                                               VerticalAlignment="Center" Margin="0,0,8,0" />
                                    <TextBlock Text="{Binding Right}" Style="{StaticResource CaptionText}" VerticalAlignment="Center"
                                               TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />
                                </DockPanel>
                            </Border>
                        </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <ItemsControl x:Name="SummaryChips" Margin="0,8,0,0">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Margin="0,0,8,8" Padding="10,5" CornerRadius="14"
                                Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource Glyph}" FontSize="13" Text="{Binding Glyph}"
                                           Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                                <TextBlock Text="{Binding Text}" Margin="7,0,0,0" />
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>

        <!-- Hinweise / Ergebnis -->
        <StackPanel Grid.Row="1" Margin="24,0,24,0">
            <Border x:Name="ResultBar" Style="{StaticResource InfoBarSuccess}" Visibility="Collapsed" Margin="0,0,0,8">
                <StackPanel Orientation="Horizontal">
                    <TextBlock x:Name="ResultGlyph" Style="{StaticResource Glyph}" Text="&#xE73E;" />
                    <TextBlock x:Name="ResultText" TextWrapping="Wrap" Margin="10,0,0,0" />
                </StackPanel>
            </Border>
            <Border x:Name="WarningsBar" Style="{StaticResource InfoBarWarning}" Visibility="Collapsed" Margin="0,0,0,8">
                <Expander x:Name="WarningsExpander" IsExpanded="True" Padding="0">
                    <Expander.Header>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource Glyph}" Text="&#xE7BA;"
                                       Foreground="{DynamicResource SystemFillColorCautionBrush}" />
                            <TextBlock x:Name="WarningsHeader" FontWeight="SemiBold" Margin="10,0,0,0" />
                        </StackPanel>
                    </Expander.Header>
                    <ItemsControl x:Name="WarningsList" Margin="26,4,0,4" MaxHeight="120">
                        <ItemsControl.Template>
                            <ControlTemplate>
                                <ScrollViewer VerticalScrollBarVisibility="Auto">
                                    <ItemsPresenter />
                                </ScrollViewer>
                            </ControlTemplate>
                        </ItemsControl.Template>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding}" TextWrapping="Wrap" Margin="0,2" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Expander>
            </Border>
        </StackPanel>

        <!-- Suche und Filter -->
        <DockPanel Grid.Row="2" Margin="24,0,24,10">
            <StackPanel x:Name="SelectionButtons" DockPanel.Dock="Right" Orientation="Horizontal">
                <Button Style="{StaticResource SubtleButton}" Click="SelectAll_Click" ToolTip="Alle angezeigten Aktionen auswählen">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource Glyph}" Text="&#xE8B3;" />
                        <TextBlock Text="Alle auswählen" Margin="8,0,0,0" />
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource SubtleButton}" Click="SelectNone_Click" ToolTip="Alle angezeigten Aktionen abwählen">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource Glyph}" Text="&#xE8E6;" />
                        <TextBlock Text="Keine auswählen" Margin="8,0,0,0" />
                    </StackPanel>
                </Button>
            </StackPanel>

            <Grid Width="300">
                <TextBox x:Name="SearchBox" TextChanged="SearchBox_TextChanged" Padding="34,5,6,6" />
                <TextBlock Style="{StaticResource Glyph}" Text="&#xE721;" FontSize="14" HorizontalAlignment="Left"
                           Margin="12,0,0,0" IsHitTestVisible="False"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                <TextBlock x:Name="SearchPlaceholder" Text="Datei suchen …" Margin="35,0,0,0" VerticalAlignment="Center"
                           IsHitTestVisible="False" Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
            </Grid>
            <ComboBox x:Name="FilterBox" Width="220" Margin="10,0,0,0" SelectedIndex="0" SelectionChanged="FilterBox_SelectionChanged"
                      HorizontalAlignment="Left">
                <ComboBoxItem Content="Alle Aktionen" />
                <ComboBoxItem Content="Neu und Überschreiben" />
                <ComboBoxItem Content="Umbenennen" />
                <ComboBoxItem Content="Löschen" />
                <ComboBoxItem Content="Ordner anlegen/löschen" />
                <ComboBoxItem Content="Nur Fehler" />
                <ComboBoxItem Content="Nur übersprungene" />
            </ComboBox>
        </DockPanel>

        <!-- Tabelle -->
        <Border Grid.Row="3" Margin="24,0,24,0" Style="{StaticResource Card}" Padding="0">
            <Grid>
                <DataGrid x:Name="OperationsGrid" BorderThickness="0" Background="Transparent"
                          AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False"
                          HeadersVisibility="Column" SelectionMode="Extended" GridLinesVisibility="None"
                          EnableRowVirtualization="True" EnableColumnVirtualization="True"
                          MouseDoubleClick="OperationsGrid_MouseDoubleClick">
                    <DataGrid.ContextMenu>
                        <ContextMenu Opened="GridContextMenu_Opened">
                            <MenuItem x:Name="ShowLeftMenuItem" Header="Im Explorer anzeigen (links)" Click="ShowLeft_Click">
                                <MenuItem.Icon><TextBlock Style="{StaticResource Glyph}" Text="&#xE838;" /></MenuItem.Icon>
                            </MenuItem>
                            <MenuItem x:Name="ShowRightMenuItem" Header="Im Explorer anzeigen (rechts)" Click="ShowRight_Click">
                                <MenuItem.Icon><TextBlock Style="{StaticResource Glyph}" Text="&#xE838;" /></MenuItem.Icon>
                            </MenuItem>
                            <MenuItem x:Name="CopyPathMenuItem" Header="Pfad kopieren" Click="CopyPath_Click">
                                <MenuItem.Icon><TextBlock Style="{StaticResource Glyph}" Text="&#xE8C8;" /></MenuItem.Icon>
                            </MenuItem>
                        </ContextMenu>
                    </DataGrid.ContextMenu>
                    <DataGrid.Columns>
                        <DataGridTemplateColumn Header="" Width="40" CanUserSort="False" CanUserResize="False">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <CheckBox HorizontalAlignment="Center" VerticalAlignment="Center" MinWidth="0"
                                              IsChecked="{Binding Operation.IsSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                              IsEnabled="{Binding IsEditable}" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn x:Name="PairColumn" Header="Ordnerpaar" Binding="{Binding PairName}" IsReadOnly="True" Width="140"
                                            ElementStyle="{StaticResource CellText}" />
                        <DataGridTemplateColumn Header="Aktion" Width="150" SortMemberPath="Operation.Kind">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Style="{StaticResource KindGlyphStyle}" Text="{Binding KindGlyph}" FontSize="14" />
                                        <TextBlock Text="{Binding Operation.KindText}" Margin="8,0,0,0" />
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="Ziel" Binding="{Binding TargetText}" IsReadOnly="True" Width="80"
                                            ElementStyle="{StaticResource CellText}" />
                        <DataGridTextColumn Header="Datei / Ordner" Binding="{Binding Operation.DisplayPath}" IsReadOnly="True" Width="*" MinWidth="160"
                                            ElementStyle="{StaticResource CellText}" />
                        <DataGridTextColumn Header="Größe" Binding="{Binding SizeText}" IsReadOnly="True" Width="90" SortMemberPath="Operation.Size"
                                            ElementStyle="{StaticResource CellTextRight}" />
                        <DataGridTextColumn Header="Grund" Binding="{Binding Operation.Reason}" IsReadOnly="True" Width="170"
                                            ElementStyle="{StaticResource CellText}" />
                        <DataGridTemplateColumn Header="Ergebnis" Width="190" SortMemberPath="Operation.Status">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" ToolTip="{Binding StatusText}">
                                        <TextBlock Style="{StaticResource StatusGlyphStyle}" Text="{Binding StatusGlyph}" />
                                        <TextBlock Text="{Binding StatusText}" Margin="6,0,0,0" TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>

                <!-- Anzeige, wenn nichts zu tun ist oder der Filter nichts findet -->
                <StackPanel x:Name="EmptyGridPanel" HorizontalAlignment="Center" VerticalAlignment="Center"
                            Visibility="Collapsed" IsHitTestVisible="False">
                    <TextBlock x:Name="EmptyGridGlyph" Style="{StaticResource Glyph}" FontSize="40" Text="&#xE73E;"
                               Foreground="{DynamicResource SystemFillColorSuccessBrush}" />
                    <TextBlock x:Name="EmptyGridText" FontSize="15" FontWeight="SemiBold" Margin="0,12,0,0"
                               HorizontalAlignment="Center" />
                </StackPanel>

                <!-- Erklärung während der Vorschau: was gerade gelesen und verglichen wird -->
                <Border x:Name="WorkingPanel" Visibility="Collapsed" CornerRadius="8"
                        Background="{DynamicResource SolidBackgroundFillColorBaseBrush}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel MaxWidth="640" Margin="24,28" HorizontalAlignment="Center">
                        <TextBlock x:Name="WorkingTitle" Text="Was passiert gerade?" FontSize="18" FontWeight="SemiBold" />
                        <TextBlock Style="{StaticResource SecondaryText}" Margin="0,8,0,16"
                                   Text="SyncToyNext liest in beiden Ordnern alle Dateien und Unterordner ein (Name, Größe und Änderungsdatum) und vergleicht sie mit dem Stand nach dem letzten Lauf. So ergibt sich, was neu, geändert, umbenannt oder gelöscht ist und kopiert bzw. gelöscht werden muss." />

                        <ItemsControl x:Name="StepsList">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,0,0,14">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock x:Name="StepGlyph" Text="{Binding Glyph}" FontSize="18" Width="28"
                                                   VerticalAlignment="Top" Margin="0,1,0,0"
                                                   Foreground="{DynamicResource TextFillColorTertiaryBrush}">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock" BasedOn="{StaticResource Glyph}" />
                                            </TextBlock.Style>
                                        </TextBlock>
                                        <StackPanel Grid.Column="1" Margin="10,0,0,0">
                                            <TextBlock x:Name="StepTitle" Text="{Binding Title}" FontWeight="SemiBold"
                                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                            <TextBlock Text="{Binding Detail}" Style="{StaticResource CaptionText}" Margin="0,2,0,0" TextWrapping="Wrap" />
                                        </StackPanel>
                                    </Grid>
                                    <DataTemplate.Triggers>
                                        <DataTrigger Binding="{Binding State}" Value="Running">
                                            <Setter TargetName="StepGlyph" Property="Foreground" Value="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                                            <Setter TargetName="StepTitle" Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding State}" Value="Done">
                                            <Setter TargetName="StepGlyph" Property="Foreground" Value="{DynamicResource SystemFillColorSuccessBrush}" />
                                            <Setter TargetName="StepTitle" Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
                                        </DataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <Border Style="{StaticResource InfoBarInfo}" Margin="0,6,0,0">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource Glyph}" Text="&#xE946;"
                                           Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                                <TextBlock TextWrapping="Wrap" Margin="10,0,0,0" MaxWidth="560"
                                           Text="Dabei wird noch nichts verändert. Erst „Ausführen“ kopiert, benennt um oder löscht Dateien. Auf Netzlaufwerken (NAS) dauert das Einlesen am längsten." />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
                </Border>
            </Grid>
        </Border>

        <!-- Fußzeile -->
        <Border Grid.Row="4" Margin="0,12,0,0" BorderThickness="0,1,0,0"
                BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}"
                Background="{DynamicResource LayerFillColorDefaultBrush}" Padding="24,12">
            <!-- Während der Ausführung wandert der Fortschritt in die obere Zeile über die volle Breite (siehe SetTransferLayout). -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel x:Name="ProgressArea" Grid.Row="1" Grid.Column="0" VerticalAlignment="Center" Margin="0,0,20,0">
                    <!-- Gesamtstand, Tempo und Restzeit -->
                    <DockPanel x:Name="TransferHeader" Visibility="Collapsed" Margin="0,0,0,6">
                        <TextBlock x:Name="TransferTimeText" DockPanel.Dock="Right" Style="{StaticResource CaptionText}"
                                   VerticalAlignment="Bottom" Margin="16,0,0,0" />
                        <TextBlock x:Name="TransferText" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
                    </DockPanel>

                    <ProgressBar x:Name="Progress" Height="4" Maximum="1" Visibility="Hidden" />
                    <TextBlock x:Name="ProgressText" Style="{StaticResource CaptionText}" TextTrimming="CharacterEllipsis"
                               TextWrapping="NoWrap" Margin="0,6,0,0" />

                    <!-- Die laufende Datei; große Dateien mit eigenem Balken -->
                    <StackPanel x:Name="TransferFile" Visibility="Collapsed" Margin="0,8,0,0">
                        <DockPanel>
                            <TextBlock x:Name="CurrentFileAmountText" DockPanel.Dock="Right" Style="{StaticResource CaptionText}"
                                       Margin="16,0,0,0" />
                            <TextBlock Style="{StaticResource Glyph}" Text="&#xE8A5;" FontSize="12" Margin="0,1,6,0"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                            <TextBlock x:Name="CurrentFileText" Style="{StaticResource CaptionText}"
                                       TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
                        </DockPanel>
                        <ProgressBar x:Name="CurrentFileProgress" Height="3" Maximum="1" Margin="0,5,0,0" Visibility="Hidden" />
                    </StackPanel>
                </StackPanel>

                <CheckBox x:Name="FollowCheckBox" Grid.Row="1" Grid.Column="0" Content="Laufende Datei in der Tabelle zeigen"
                          IsChecked="True" Visibility="Collapsed" VerticalAlignment="Center"
                          ToolTip="Blättert die Tabelle automatisch zur Datei, die gerade bearbeitet wird." />

                <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="RunButton" Style="{StaticResource PrimaryButton}" Click="Run_Click" IsEnabled="False">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource Glyph}" Text="&#xE768;" />
                            <TextBlock Text="Ausführen" Margin="8,0,0,0" />
                        </StackPanel>
                    </Button>
                    <Button x:Name="CancelButton" Click="Cancel_Click" Visibility="Collapsed" MinWidth="110" Margin="8,0,0,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource Glyph}" Text="&#xE711;" />
                            <TextBlock Text="Abbrechen" Margin="8,0,0,0" />
                        </StackPanel>
                    </Button>
                    <Button x:Name="CloseButton" Content="Schließen" Click="Close_Click" MinWidth="110" Margin="8,0,0,0" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
