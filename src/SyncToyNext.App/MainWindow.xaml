<Window x:Class="SyncToyNext.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SyncToyNext"
        Width="920" Height="580" MinWidth="720" MinHeight="440"
        WindowStartupLocation="CenterScreen">
    <DockPanel>
        <Menu DockPanel.Dock="Top">
            <MenuItem Header="_Datei">
                <MenuItem Header="_Neues Ordnerpaar …" Click="NewPair_Click" />
                <Separator />
                <MenuItem Header="_Beenden" Click="Exit_Click" />
            </MenuItem>
            <MenuItem Header="_Extras">
                <MenuItem Header="_Protokoll öffnen" Click="OpenLog_Click" />
                <MenuItem Header="_Zeitgesteuert ausführen (Aufgabenplanung) …" Click="Scheduler_Click" />
            </MenuItem>
            <MenuItem Header="_Hilfe">
                <MenuItem Header="_Über SyncToyNext" Click="About_Click" />
            </MenuItem>
        </Menu>

        <Border DockPanel.Dock="Bottom" BorderThickness="0,1,0,0"
                BorderBrush="{x:Static SystemColors.ActiveBorderBrush}" Padding="6">
            <DockPanel>
                <Button x:Name="RunAllButton" DockPanel.Dock="Right" Content="Alle ausführen"
                        Click="RunAll_Click"
                        ToolTip="Alle Ordnerpaare ausführen, bei denen „Bei Alle ausführen berücksichtigen“ aktiv ist" />
                <StackPanel Orientation="Horizontal">
                    <Button Content="Neues Ordnerpaar …" Click="NewPair_Click" />
                    <Button x:Name="EditButton" Content="Bearbeiten …" Click="EditPair_Click" />
                    <Button x:Name="DeleteButton" Content="Löschen" Click="DeletePair_Click" />
                </StackPanel>
            </DockPanel>
        </Border>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="250" MinWidth="160" />
                <ColumnDefinition Width="5" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <DockPanel Grid.Column="0">
                <TextBlock DockPanel.Dock="Top" Text="Ordnerpaare" FontWeight="SemiBold" Margin="10,10,10,6" />
                <ListBox x:Name="PairList" DisplayMemberPath="Name" BorderThickness="0"
                         SelectionChanged="PairList_SelectionChanged"
                         MouseDoubleClick="PairList_MouseDoubleClick" />
            </DockPanel>

            <GridSplitter Grid.Column="1" Width="5" HorizontalAlignment="Stretch"
                          Background="{x:Static SystemColors.ControlLightBrush}" />

            <Grid Grid.Column="2" Margin="20,14,20,14">
                <TextBlock x:Name="EmptyText" TextWrapping="Wrap" VerticalAlignment="Center"
                           HorizontalAlignment="Center" TextAlignment="Center" FontSize="14"
                           Style="{StaticResource Hint}"
                           Text="Noch keine Ordnerpaare vorhanden.&#x0a;Klicken Sie auf „Neues Ordnerpaar …“, um zu beginnen." />

                <ScrollViewer x:Name="DetailsPanel" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
                    <StackPanel>
                        <TextBlock x:Name="PairNameText" FontSize="22" FontWeight="SemiBold" TextWrapping="Wrap" />

                        <Grid Margin="0,14,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Grid.Resources>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Margin" Value="0,4,12,4" />
                                    <Setter Property="TextWrapping" Value="Wrap" />
                                </Style>
                            </Grid.Resources>

                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Linker Ordner:" FontWeight="SemiBold" />
                            <TextBlock Grid.Row="0" Grid.Column="1">
                                <Hyperlink Click="OpenLeft_Click" ToolTip="Im Explorer öffnen"><Run x:Name="LeftPathRun" /></Hyperlink>
                            </TextBlock>

                            <TextBlock Grid.Row="1" Grid.Column="0" Text="Rechter Ordner:" FontWeight="SemiBold" />
                            <TextBlock Grid.Row="1" Grid.Column="1">
                                <Hyperlink Click="OpenRight_Click" ToolTip="Im Explorer öffnen"><Run x:Name="RightPathRun" /></Hyperlink>
                            </TextBlock>

                            <TextBlock Grid.Row="2" Grid.Column="0" Text="Aktion:" FontWeight="SemiBold" />
                            <StackPanel Grid.Row="2" Grid.Column="1">
                                <TextBlock x:Name="ActionText" FontWeight="SemiBold" Margin="0,4,0,0" />
                                <TextBlock x:Name="ActionDescriptionText" Style="{StaticResource Hint}" Margin="0,0,0,4" />
                            </StackPanel>

                            <TextBlock Grid.Row="3" Grid.Column="0" Text="Optionen:" FontWeight="SemiBold" />
                            <TextBlock Grid.Row="3" Grid.Column="1" x:Name="OptionsText" />

                            <TextBlock Grid.Row="4" Grid.Column="0" Text="Letzter Lauf:" FontWeight="SemiBold" />
                            <TextBlock Grid.Row="4" Grid.Column="1" x:Name="LastRunText" />
                        </Grid>

                        <StackPanel Orientation="Horizontal" Margin="-4,18,0,0">
                            <Button Content="Vorschau" Click="Preview_Click" MinWidth="120"
                                    ToolTip="Zeigt, was passieren würde, ohne etwas zu ändern" />
                            <Button Content="Ausführen" Click="Run_Click" MinWidth="120" FontWeight="SemiBold" />
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Grid>
    </DockPanel>
</Window>
