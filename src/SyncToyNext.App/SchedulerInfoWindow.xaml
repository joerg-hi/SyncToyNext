<Window x:Class="SyncToyNext.App.SchedulerInfoWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Zeitgesteuert ausführen"
        Icon="Assets/SyncToyNext.ico"
        Width="680" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <StackPanel>
        <StackPanel Margin="24,18,24,8">
            <StackPanel Orientation="Horizontal">
                <Border Style="{StaticResource IconBadge}" Width="40" Height="40" CornerRadius="20"
                        Background="{DynamicResource AccentFillColorDefaultBrush}">
                    <TextBlock Style="{StaticResource Glyph}" Text="&#xE823;" FontSize="18"
                               Foreground="{DynamicResource TextOnAccentFillColorPrimaryBrush}" />
                </Border>
                <TextBlock Text="Zeitgesteuert ausführen" FontSize="20" FontWeight="SemiBold"
                           VerticalAlignment="Center" Margin="14,0,0,0" />
            </StackPanel>

            <TextBlock Style="{StaticResource SecondaryText}" Margin="0,14,0,0">
                Wie bei SyncToy gibt es keinen eingebauten Zeitplaner. Stattdessen startet die Windows-Aufgabenplanung
                das Kommandozeilenprogramm <Bold>SyncToyNextCmd.exe</Bold>, das neben SyncToyNext.exe liegt.
            </TextBlock>

            <Border Style="{StaticResource Card}" Margin="0,14,0,0">
                <StackPanel>
                    <TextBlock Text="Alle aktiven Ordnerpaare ausführen" FontWeight="SemiBold" Margin="0,0,0,6" />
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Margin="8,0,0,0" Click="CopyAll_Click" ToolTip="In die Zwischenablage kopieren">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource Glyph}" Text="&#xE8C8;" />
                                <TextBlock Text="Kopieren" Margin="8,0,0,0" />
                            </StackPanel>
                        </Button>
                        <TextBox x:Name="AllCommandBox" IsReadOnly="True" FontFamily="Cascadia Mono, Consolas" />
                    </DockPanel>

                    <StackPanel x:Name="SinglePanel">
                        <TextBlock x:Name="SingleLabel" FontWeight="SemiBold" Margin="0,14,0,6" />
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Margin="8,0,0,0" Click="CopySingle_Click" ToolTip="In die Zwischenablage kopieren">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Style="{StaticResource Glyph}" Text="&#xE8C8;" />
                                    <TextBlock Text="Kopieren" Margin="8,0,0,0" />
                                </StackPanel>
                            </Button>
                            <TextBox x:Name="SingleCommandBox" IsReadOnly="True" FontFamily="Cascadia Mono, Consolas" />
                        </DockPanel>
                    </StackPanel>
                </StackPanel>
            </Border>

            <TextBlock Text="So richten Sie die Aufgabe ein" Style="{StaticResource SectionTitle}" Margin="0,18,0,6" />
            <TextBlock TextWrapping="Wrap" LineHeight="22">
                1. „Aufgabenplanung öffnen“ anklicken.<LineBreak />
                2. Rechts auf „Einfache Aufgabe erstellen …“ klicken und einen Namen vergeben.<LineBreak />
                3. Den Zeitpunkt wählen, zum Beispiel täglich um 18:00 Uhr.<LineBreak />
                4. Als Aktion „Programm starten“ wählen.<LineBreak />
                5. Bei „Programm/Skript“ den Pfad zu SyncToyNextCmd.exe eintragen (alles in Anführungszeichen),
                bei „Argumente hinzufügen“ den Rest ab -R.<LineBreak />
                6. Fertigstellen. Die Ergebnisse stehen anschließend im Protokoll.
            </TextBlock>
        </StackPanel>

        <Border BorderThickness="0,1,0,0" BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}"
                Background="{DynamicResource LayerFillColorDefaultBrush}" Padding="24,14" Margin="0,12,0,0">
            <DockPanel>
                <Button DockPanel.Dock="Right" Content="Schließen" IsCancel="True" IsDefault="True" MinWidth="110" />
                <Button Click="OpenScheduler_Click" HorizontalAlignment="Left">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource Glyph}" Text="&#xE8A7;" />
                        <TextBlock Text="Aufgabenplanung öffnen" Margin="8,0,0,0" />
                    </StackPanel>
                </Button>
            </DockPanel>
        </Border>
    </StackPanel>
</Window>
