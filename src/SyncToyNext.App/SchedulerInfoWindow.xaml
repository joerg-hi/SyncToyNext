<Window x:Class="SyncToyNext.App.SchedulerInfoWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Zeitgesteuert ausführen"
        Width="620" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <StackPanel Margin="18,14">
        <TextBlock TextWrapping="Wrap">
            Wie bei SyncToy gibt es keinen eingebauten Zeitplaner. Stattdessen startet die Windows-Aufgabenplanung
            das Kommandozeilenprogramm <Bold>SyncToyNextCmd.exe</Bold>:
        </TextBlock>

        <TextBlock Text="Alle aktiven Ordnerpaare ausführen:" Style="{StaticResource FieldLabel}" />
        <DockPanel>
            <Button DockPanel.Dock="Right" Content="Kopieren" Margin="6,0,0,0" Click="CopyAll_Click" />
            <TextBox x:Name="AllCommandBox" IsReadOnly="True" FontFamily="Consolas" Padding="3" VerticalContentAlignment="Center" />
        </DockPanel>

        <StackPanel x:Name="SinglePanel">
            <TextBlock x:Name="SingleLabel" Style="{StaticResource FieldLabel}" />
            <DockPanel>
                <Button DockPanel.Dock="Right" Content="Kopieren" Margin="6,0,0,0" Click="CopySingle_Click" />
                <TextBox x:Name="SingleCommandBox" IsReadOnly="True" FontFamily="Consolas" Padding="3" VerticalContentAlignment="Center" />
            </DockPanel>
        </StackPanel>

        <TextBlock Text="So richten Sie die Aufgabe ein:" Style="{StaticResource FieldLabel}" />
        <TextBlock TextWrapping="Wrap" LineHeight="20">
            1. Startmenü öffnen, „Aufgabenplanung“ eingeben und starten.<LineBreak />
            2. Rechts auf „Einfache Aufgabe erstellen …“ klicken und einen Namen vergeben.<LineBreak />
            3. Den Zeitpunkt wählen (z. B. täglich um 18:00 Uhr).<LineBreak />
            4. Aktion „Programm starten“ wählen.<LineBreak />
            5. Bei „Programm/Skript“ den Pfad zu SyncToyNextCmd.exe eintragen und bei
            „Argumente hinzufügen“ den Teil ab -R.<LineBreak />
            6. Fertigstellen. Ergebnisse stehen anschließend im Protokoll (Menü Extras).
        </TextBlock>

        <Button Content="Aufgabenplanung öffnen" HorizontalAlignment="Left" Margin="-4,12,0,0" Click="OpenScheduler_Click" />

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,-4,0">
            <Button Content="Schließen" IsCancel="True" IsDefault="True" />
        </StackPanel>
    </StackPanel>
</Window>
